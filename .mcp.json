{
  "mcpServers": {
    "sonarqube": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm", "--init", "--pull=always",
        "-e", "SONARQUBE_TOKEN",
        "-e", "SONARQUBE_URL",
        "-e", "TELEMETRY_DISABLED=true",
        "-v", "${workspaceFolder}:/app/mcp-workspace:rw",
        "sonarsource/sonarqube-mcp:<surum>"
      ],
      "env": {
        "SONARQUBE_TOKEN": "${env:SONARQUBE_TOKEN}",
        "SONARQUBE_URL": "${env:SONARQUBE_URL}"
      }
    }
  }
}
